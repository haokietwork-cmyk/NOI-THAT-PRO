# ============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN NỘI THẤT PRO (ENVIRONMENT VARIABLES)
# Sao chép file này thành .env.local và điền các giá trị thực tế của bạn
# ============================================================================

# ----------------------------------------------------------------------------
# 1. KẾT NỐI SUPABASE (DATABASE, AUTH, STORAGE & RLS)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://awpzkxurcqyzdedipymx.supabase.co
# Key công khai (Public / Anon / Publishable key) dùng cho Client-side:
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_3UzgXbPY9ToxtuwCBYnccg_0mhetgEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_3UzgXbPY9ToxtuwCBYnccg_0mhetgEY
# Service Role Key (Bí mật - CHỈ dùng trong Server API & Webhook, không để lộ ra ngoài):
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ----------------------------------------------------------------------------
# 2. CỔNG THANH TOÁN VIETQR ĐỘNG (NAPAS / SEPAY / PAYOS)
# ----------------------------------------------------------------------------
# Thông tin tài khoản nhận tiền tạo mã QR Napas 247:
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=99990912345678
VIETQR_ACCOUNT_NAME=NGUYEN VAN KIET

# Tích hợp SePay Webhook (https://sepay.vn):
SEPAY_API_KEY=your_sepay_api_key_here
SEPAY_WEBHOOK_TOKEN=your_sepay_webhook_secret_token

# Tích hợp PayOS Webhook (https://payos.vn):
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# ----------------------------------------------------------------------------
# 3. TÊN MIỀN & ỨNG DỤNG (APP CONFIGURATION)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Khi triển khai lên Vercel / VPS:
# NEXT_PUBLIC_APP_URL=https://noithatpro.vn
